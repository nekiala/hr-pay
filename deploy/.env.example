# Copy to .env next to docker-compose.yml and fill in. Never commit .env: it holds passwords.

# The address people type to reach HR Pay. Its DNS record must point to this server.
DOMAIN=paie.example.cd
# Only when HTTPS is not on port 443 (HTTPS_PORT below): the full address, for example https://paie.example.cd:8443
PUBLIC_URL=
# HTTP_PORT=80
# HTTPS_PORT=443
# An email address for Let's Encrypt certificates, or "internal" for a server the internet cannot reach.
TLS_MODE=it@example.cd

# Database (make the password long and random, for example: openssl rand -base64 30).
DB_NAME=hrpay
DB_USER=hrpay
DB_PASSWORD=

# The first administrator, created only when the database has no users yet. Remove both after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# "on-premise" (a customer's own server: install the licence file on the Licence page) or "saas" (your own servers,
# where you set each company's plan on the Companies page).
LICENSING_MODE=on-premise

# Email: check-in codes, raises, alerts to administrators. Without SMTP_HOST, emails only appear on the Messages page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=HR Pay <no-reply@example.cd>

# WhatsApp Cloud API (optional).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Backups: daily time (Kinshasa time), how many to keep, where on this server.
BACKUP_AT=02:00
KEEP_DAILY=14
KEEP_MONTHLY=12
BACKUP_DIR=./backups
# Off-site copy: an rclone remote and folder, configured in rclone/rclone.conf. Strongly recommended.
RCLONE_REMOTE=

# Memory for the app: a share of what the container may use.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
