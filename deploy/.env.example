# Copy to .env next to docker-compose.yml and fill in. Never commit .env: it holds passwords.

# The address people type to reach HR Pay. Its DNS record must point to this server.
DOMAIN=paie.example.cd
# Only when HTTPS is not on port 443 (HTTPS_PORT below): the full address, for example https://paie.example.cd:8443
PUBLIC_URL=
# HTTP_PORT=80
# HTTPS_PORT=443
# An email address for Let's Encrypt certificates, or "internal" for a server the internet cannot reach.
TLS_MODE=it@example.cd
# Behind Cloudflare (proxied DNS record, SSL/TLS mode "Full (strict)"), uncomment both lines so the app sees each
# visitor's real address (Cloudflare's ranges: https://www.cloudflare.com/ips/).
# TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
# CLIENT_IP_HEADER=CF-Connecting-IP

# Database (make the password long and random, for example: openssl rand -base64 30).
DB_NAME=hrpay
DB_USER=hrpay
DB_PASSWORD=

# The first administrator, created only when the database has no users yet. Remove both after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# "on-premise" (a customer's own server: install the licence file on the Licence page) or "saas" (your own servers,
# where you set each company's plan on the Companies page).
LICENSING_MODE=on-premise

# Background jobs (payroll calculation and closing, imports, zips): threads per app server. A large installation can
# also run "docker compose --profile worker up -d" (WORKER_THREADS threads) and set APP_ROLE=web to leave jobs to it.
# JOBS_WORKERS=2
# WORKER_THREADS=4
# APP_ROLE=all

# Key that encrypts bank and mobile money accounts, CNSS and tax numbers and authenticator secrets in the database.
# Make one with: openssl rand -base64 32
# Keep a copy somewhere else than this server and its backups (a password manager): without it, those values in a
# backup can never be read again. Never change it once set.
HRPAY_DATA_KEY=

# Optional notifications on phones (Web Push). Make the pair yourself on a trusted machine, once:
#   npx web-push generate-vapid-keys
# then paste the public and private key here. The private key stays on this server only: never commit it.
# Without them, notifications still show under the bell in the app.
APP_PUSH_PUBLIC_KEY=
APP_PUSH_PRIVATE_KEY=
APP_PUSH_SUBJECT=mailto:support@example.com

# Optional "Sign in with Google" / "Sign in with Microsoft" (see the README). Each company sets its Microsoft tenant
# ID on its Company page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email: check-in codes, raises, alerts to administrators. The provider's "Email server" page and each company's own
# email server take over from these. With none of them, emails only appear on the Messages page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_AUTH=true          # false for a relay that accepts this server by its IP address (Google Workspace SMTP relay)
# SMTP_STARTTLS=true
# SMTP_EHLO=paie.example.cd   # the name this server gives the mail server; Google's relay needs a real one
MAIL_FROM=HR Pay <no-reply@example.cd>

# WhatsApp Cloud API (optional). Better: set it up in the app under System > WhatsApp (see WHATSAPP.md).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Backups: daily time (Kinshasa time), how many to keep, where on this server.
BACKUP_AT=02:00
KEEP_DAILY=14
KEEP_MONTHLY=12
BACKUP_DIR=./backups
# Off-site copy: an rclone remote and folder, configured in rclone/rclone.conf. Strongly recommended.
RCLONE_REMOTE=

# Memory for the app: a share of what the container may use.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
